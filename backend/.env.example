# Neon (or local) PostgreSQL connection string
# Neon: Dashboard → Project → Connect → Connection string (URI)
# Example: postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

JWT_SECRET=change-me
ADMIN_EMAILS=admin@safeguard.com
SEED_IF_EMPTY=true
FRONTEND_URL=http://localhost:8080

# Optional: allow short password-reset TTL in local verification scripts
# ALLOW_SHORT_RESET_TTL=true
